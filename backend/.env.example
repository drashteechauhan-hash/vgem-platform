# VGEM backend environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Real government GST verification API key (from gstinapi.in).
# REQUIRED for /verify-gst, /ai/cross-verify and /verify/bidder to hit the live API.
GST_API_KEY=

# Optional: override the SQLite database file path (default: vgem.db)
# VGEM_DB_PATH=vgem.db

# Optional: restrict CORS to specific origins (comma-separated). Default: *
# CORS_ORIGINS=https://vgem.vercel.app,http://localhost:5173
